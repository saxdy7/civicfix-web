{
  "expo": {
    "name": "CivicFix",
    "slug": "civicfix-mobile",
    "version": "1.0.0",
    "scheme": "civicfix",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.civicfix.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "org.civicfix.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "CivicFix needs access to your photos to attach evidence to a report.",
          "cameraPermission": "CivicFix needs access to your camera to photograph a civic issue or resolution evidence."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CivicFix needs your location to pin a report's exact location and to navigate field workers to assignments."
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#000000"
        }
      ],
      "expo-web-browser"
    ]
  }
}
