EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/v1
# Maps use MapLibre GL with free OpenStreetMap tiles — no map API key required.

# Clerk (auth) + Convex (database/realtime) — same backend/Clerk instance the
# web app uses (see repo-root convex/*.ts and apps/web/.env.example). Get
# these from the same Clerk dashboard project and the same
# `npx convex dev` output used to set up apps/web.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
EXPO_PUBLIC_CONVEX_URL=
